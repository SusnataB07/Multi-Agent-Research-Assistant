# Copy this file to .env and fill in ONLY the provider you use.
# Do not put spaces, quotes or comments after a value.

# Choose one: gemini | groq | mistral  (default: gemini)
LLM_PROVIDER=gemini

# Optional: override the default model for your provider.
# Defaults: gemini = gemini-3.5-flash, groq = llama-3.3-70b-versatile, mistral = mistral-small-2506
# LLM_MODEL=

# Model API key: fill in the one that matches LLM_PROVIDER
# Gemini (free): https://aistudio.google.com/apikey
# (GEMINI_API_KEY also works in place of GOOGLE_API_KEY)
GOOGLE_API_KEY=

# Groq (free): https://console.groq.com/keys
GROQ_API_KEY=

# Mistral: https://console.mistral.ai
MISTRAL_API_KEY=

# Required for web search with every provider: https://tavily.com
TAVILY_API_KEY=
